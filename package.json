{
  "name": "skis",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Route planner for a day's skiing. Tell it where you are, when you need to be down, and what you're comfortable on.",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/make-fetch-page.mjs && vite build",
    "preview": "vite preview",
    "test": "node src/solver.test.js && node scripts/osm/graph.test.mjs && node src/lib/graph.test.js && node src/map/field.test.js && node src/map/camera.test.js && node src/lib/geo.test.js && node src/lib/progress.test.js && node src/lib/direct.test.js && node src/lib/plan.test.js && node src/lib/friends.test.js && node scripts/validate-layers.mjs && node scripts/check-contrast.mjs",
    "bench": "node scripts/bench-solver.js",
    "ios": "npm run build && npx cap sync ios && npx cap open ios",
    "ios:prepare": "node scripts/ios-prepare.mjs",
    "ios:sync": "npm run build && npx cap sync ios",
    "test:solver": "node src/solver.test.js",
    "test:map": "node scripts/validate-layers.mjs",
    "e2e": "npm run build && node scripts/e2e.mjs",
    "e2e:only": "node scripts/e2e.mjs",
    "dev:host": "vite --host",
    "build:single": "vite build --config vite.config.singlefile.js",
    "test:palette": "node scripts/check-contrast.mjs",
    "audit": "npm run build && node scripts/audit.mjs",
    "features": "npm run build && node scripts/features.mjs",
    "resort": "node scripts/build-resort.mjs",
    "resort:query": "node scripts/build-resort.mjs --query",
    "resort:page": "node scripts/make-fetch-page.mjs",
    "icons": "node scripts/make-icons.mjs",
    "preflight": "node scripts/preflight.mjs",
    "resort:turbo": "node scripts/build-resort.mjs --turbo",
    "bench:scale": "node scripts/bench-scale.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/inter": "^5.1.1",
    "@fontsource-variable/outfit": "^5.1.1",
    "maplibre-gl": "^6.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/status-bar": "^8.0.3",
    "@maplibre/maplibre-gl-style-spec": "^26.4.1",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.1"
  }
}
