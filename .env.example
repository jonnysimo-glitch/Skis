# MapTiler API key — free tier at maptiler.com
# Used for terrain elevation tiles and the winter/ski basemap.
#
# Without it the app still runs: the 3D map falls back to a terrain view built
# from the resort graph's own altitudes. You can orbit and see the route, but
# you lose real satellite terrain, pistes and lift lines from the basemap.
VITE_MAPTILER_KEY=your_key_here
